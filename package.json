{
  "name": "eldrun",
  "private": true,
  "version": "0.1.57",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run mobile:build",
    "mobile:build": "tsc -p tsconfig.mobile.json && vite build --config vite.mobile.config.ts",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretauri:dev": "./scripts/guard-single-instance.sh",
    "tauri:dev": "tauri dev --no-watch",
    "pretauri:dev:watch": "./scripts/guard-single-instance.sh",
    "tauri:dev:watch": "tauri dev",
    "backend:stale": "./scripts/backend-stale.sh",
    "tauri:build": "tauri build",
    "tauri:bundle": "tauri build --bundles appimage,deb",
    "tauri:bundle:mac": "tauri build --bundles dmg",
    "package": "./scripts/package-local.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "fflate": "^0.8.3",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "react-scan": "^0.5.7",
    "tailwindcss": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite": "^5",
    "vitest": "^4.1.8"
  }
}

#!/usr/bin/env bash
#
# Advisory: is the phone being served a PWA older than the tree you just
# committed?
#
# The mobile bundle is baked into the Rust binary at compile time (src-tauri/
# build.rs embeds mobile-dist/), so it can be built, committed, green, and
# simply not in the running sidecar — with nothing anywhere saying so. That is
# how a bundle predating several days of mobile work kept being served to the
# phone while the features sat in the code.
#
# A commit is the cheapest honest moment to check: frequent, local, and — unlike
# a build — never running in CI, so this can never break a gate.
#
# Deliberately --mobile-only. Backend staleness is by design (`--no-watch` lets
# src-tauri edits accumulate until the user restarts deliberately), so reporting
# it on every commit would be noise, and noise is what gets ignored.
#
# Never fails a commit: git ignores a post-commit exit code, and this stays
# silent unless something is actually stale.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
check="$ROOT/scripts/backend-stale.sh"
if [ -x "$check" ]; then
  # Before the rebuild below is queued, so this reports the drift the commit
  # was made against rather than the one the queued build is already fixing.
  if ! report="$("$check" --mobile-only 2>/dev/null)"; then
    [ -n "$report" ] && printf '\n%s\n\n' "$report"
  fi
fi

# Move the frozen "Eldrun (dev)" snapshot to what was just committed (user,
# 2026-09-03). Returns at once — the build runs detached, nice'd, and coalesces
# with any other commit's — and never launches anything. Off:
# `git config eldrun.autoDevBuild false`, or ELDRUN_NO_AUTO_DEV_BUILD=1 for one
# commit.
freeze="$ROOT/scripts/package-dev-auto.sh"
[ -x "$freeze" ] && "$freeze" --queue || true
exit 0
